# ─────────────────────────────────────────────────────────────────────────────
# Alikati Beauty Home — environment template
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project endpoint and anon key (browser-safe, RLS-constrained).
# Leave BOTH blank to run the site in demo mode with bundled seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by /api/booking and admin server actions.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fallback WhatsApp / voice number used if salon_settings cannot be read.
# Digits only, country code first, no '+'.
NEXT_PUBLIC_WHATSAPP_NUMBER=9779869512756
NEXT_PUBLIC_PHONE=+977-9869512756

# Booking API rate limit (requests per IP per minute).
BOOKING_RATE_LIMIT_PER_MIN=5
