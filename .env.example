# ─────────────────────────────────────────────────────────────────────────────
# Alikati Beauty Home — environment template
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project endpoint and anon key (browser-safe, RLS-constrained).
# Leave BOTH blank to run the site in demo mode with bundled seed data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used by /api/booking and admin server actions.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL used for metadata, sitemap and Open Graph tags.
# Canonical URL for the sitemap and Open Graph tags. Set this to the REAL domain when
# deploying — leaving it as localhost publishes localhost in your sitemap, and pointing it
# at a preview or tunnel URL does the same with a host that will die.
# NEXT_PUBLIC_SITE_URL=https://alikatibeautyhome.com

# Fallback WhatsApp / voice number used if salon_settings cannot be read.
# Digits only, country code first, no '+'.
NEXT_PUBLIC_WHATSAPP_NUMBER=9779869512756
NEXT_PUBLIC_PHONE=+977-9869512756

# Public-API rate limits (requests per minute, per caller IP).
# All optional — each has a working default in code, listed here for visibility.
# Raise IMAGE_RATE_LIMIT_PER_MIN if a catalogue page ever exceeds it; that is the
# CPU-expensive endpoint (outbound fetch + sharp per request).
BOOKING_RATE_LIMIT_PER_MIN=5
REVIEW_RATE_LIMIT_PER_MIN=3
ORDER_RATE_LIMIT_PER_MIN=8
COUPON_RATE_LIMIT_PER_MIN=20
IMAGE_RATE_LIMIT_PER_MIN=300
